      "fp_details": [
        {
          "sentence": 18,
          "component": "Logic",
          "source": "full_name",
          "confidence": 1.0,
          "text": "The Client component can connect to the back end directly without using a Web browser."
        },
        {
          "sentence": 22,
          "component": "Logic",
          "source": "full_name",
          "confidence": 1.0,
          "text": "logic, ui.website, ui.controller represent an application of Model-View-Controller pattern."
        },
        {
          "sentence": 24,
          "component": "UI",
          "source": "full_name",
          "confidence": 1.0,
          "text": "It is a conceptual package representing the front-end of the application."
        },
        {
          "sentence": 50,
          "component": "UI",
          "source": "full_name",
          "confidence": 1.0,
          "text": "Sixth, WebApiServlet sends the result back to the browser which will then process it on the front-end."
        },
        {
          "sentence": 96,
          "component": "Logic",
          "source": "coreference",
          "confidence": 1.0,
          "text": "Although this component provides methods to perform access control, the API itself is not access controlled."
        },
        {
          "sentence": 125,
          "component": "Storage",
          "source": "coreference",
          "confidence": 1.0,
          "text": "Classes in the storage.entity package are not visible outside this component to hide information specific to data persis"
        },
        {
          "sentence": 131,
          "component": "Storage",
          "source": "coreference",
          "confidence": 1.0,
          "text": "storage.api provides the API of the component to be accessed by the logic component."
        },
        {
          "sentence": 182,
          "component": "UI",
          "source": "full_name",
          "confidence": 1.0,
          "text": "Front-end files (particularly TypeScript) are tested separately with Jest."
        },
        {
          "sentence": 185,
          "component": "UI",
          "source": "full_name",
          "confidence": 1.0,
          "text": "The E2E component has no knowledge of the internal workings of the application and can only interact either with Web bro"
        },
        {
          "sentence": 188,
          "component": "E2E",
          "source": "full_name",
          "confidence": 1.0,
          "text": "e2e.util contains helpers needed for running E2E tests."
        },
        {
          "sentence": 189,
          "component": "UI",
          "source": "full_name",
          "confidence": 1.0,
          "text": "e2e.pageobjects contains abstractions of the pages as they appear on a Browser (i.e. SUTs)."
        },
        {
          "sentence": 194,
          "component": "Logic",
          "source": "full_name",
          "confidence": 1.0,
          "text": "The Client component contains scripts that can connect directly to the application back-end for administrative purposes,"
        },
        {
          "sentence": 197,
          "component": "Logic",
          "source": "full_name",
          "confidence": 1.0,
          "text": "client.remoteapi classes needed to connect to the back end directly."
        },
        {
          "sentence": 198,
          "component": "Logic",
          "source": "full_name",
          "confidence": 1.0,
          "text": "client.scripts scripts that deal with the back end data for administrative purposes."
        }
      ],
