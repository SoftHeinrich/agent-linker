        {
          "sentence": 33,
          "component": "BBB web",
          "source": "entity",
          "confidence": 1.0,
          "text": "When you use sudo bbb-conf --setip <hostname> or sudo bbb-conf --restart, bbb-conf will run /etc/bigbluebutton/bbb-conf/"
