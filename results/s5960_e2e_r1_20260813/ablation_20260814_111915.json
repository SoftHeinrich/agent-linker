        {
          "sentence": 73,
          "component": "GAE Datastore",
          "source": "partial_name",
          "confidence": 1.0,
          "text": "Task queue workers are hybrids of user-invoked and GAE-invoked in that they are queued by users (i.e. users request for "
        },
