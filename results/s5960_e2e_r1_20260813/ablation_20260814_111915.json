          "sentence": 74,
          "component": "GAE Datastore",
          "source": "partial_name",
          "confidence": 1.0,
          "text": "This is typically used for tasks that may take a long time to finish and can exceed the 1 minute standard request proces"
        },
        {
          "sentence": 94,
          "component": "GAE Datastore",
          "source": "partial_name",
          "confidence": 1.0,
          "text": "It connects to GAE's task queue API."
        },
        {
          "sentence": 125,
          "component": "Storage",
          "source": "full_name",
          "confidence": 1.0,
          "text": "Classes in the storage.entity package are not visible outside this component to hide information specific to data persis"
        },
        {
          "sentence": 131,
          "component": "Storage",
          "source": "full_name",
          "confidence": 1.0,
          "text": "storage.api provides the API of the component to be accessed by the logic component."
        },
        {
          "sentence": 139,
          "component": "GAE Datastore",
          "source": "partial_name",
          "confidence": 1.0,
          "text": "This is not enough to compensate for eventual consistency involving multiple servers in the GAE production environment."
        },
        {
          "sentence": 144,
          "component": "GAE Datastore",
          "source": "partial_name",
          "confidence": 1.0,
          "text": "Implementation of Transaction Control has been minimized due to limitations of GAE environment and the nature of our dat"
