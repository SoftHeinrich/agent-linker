<mxfile host="Electron" agent="Claude">
  <diagram id="mediastore-trace-example" name="MediaStore trace example">
    <mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="575" pageHeight="236" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Mirror of figures/jabref_trace_example.py (matplotlib is the actual generator). -->

        <!-- column headers -->
        <mxCell id="h1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#000000;" value="Documentation">
          <mxGeometry x="0" y="0" width="210" height="15" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#000000;" value="Architecture model">
          <mxGeometry x="250" y="0" width="120" height="15" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#000000;" value="Code">
          <mxGeometry x="420" y="0" width="150" height="15" as="geometry" />
        </mxCell>

        <!-- verbatim MediaStore benchmark sentences; line breaks are typographic -->
        <mxCell id="s23" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=10;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S23 &quot;The &lt;font color=&quot;#2F5BB7&quot;&gt;&lt;b&gt;Database&lt;/b&gt;&lt;/font&gt; component represents&#xa;an actual database (e.g., MySQL).&quot;">
          <mxGeometry x="0" y="20" width="225" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s24" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=9;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S24 &quot;&lt;font color=&quot;#2F5BB7&quot;&gt;&lt;b&gt;It&lt;/b&gt;&lt;/font&gt; stores user information and meta-data&#xa;of audio files such as the name and the genre.&quot;">
          <mxGeometry x="0" y="58" width="225" height="36" as="geometry" />
        </mxCell>
        <mxCell id="gap" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="&#8942;">
          <mxGeometry x="100" y="94" width="24" height="14" as="geometry" />
        </mxCell>
        <mxCell id="s27" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=9;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S27 &quot;The &lt;font color=&quot;#2F5BB7&quot;&gt;&lt;b&gt;MediaAccess&lt;/b&gt;&lt;/font&gt; component encapsulates&#xa;&lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;database access&lt;/b&gt;&lt;/font&gt; for meta-data of audio files.&quot;">
          <mxGeometry x="0" y="108" width="225" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s28" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=10;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S28 &quot;Furthermore, &lt;font color=&quot;#2F5BB7&quot;&gt;&lt;b&gt;it&lt;/b&gt;&lt;/font&gt; fetches a list of all&#xa;available audio files.&quot;">
          <mxGeometry x="0" y="148" width="225" height="32" as="geometry" />
        </mxCell>

        <!-- architecture-model components -->
        <mxCell id="db" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE3F2;strokeColor=#4664AA;fontColor=#1F2D52;fontFamily=Courier New;fontStyle=1;fontSize=12;arcSize=14;shadow=1;" value="DB">
          <mxGeometry x="270" y="48" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="media_access" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE3F2;strokeColor=#4664AA;fontColor=#1F2D52;fontFamily=Courier New;fontStyle=1;fontSize=11;arcSize=14;shadow=1;" value="MediaAccess">
          <mxGeometry x="270" y="126" width="110" height="30" as="geometry" />
        </mxCell>

        <!-- benchmark code-file sets, summarized by count -->
        <mxCell id="code_db" parent="1" vertex="1" style="shape=card;size=10;whiteSpace=wrap;html=1;fillColor=#E7F2E2;strokeColor=#5C8A3A;fontColor=#33491F;fontFamily=Courier New;fontSize=10;shadow=1;" value="4 code files">
          <mxGeometry x="425" y="48" width="145" height="30" as="geometry" />
        </mxCell>
        <mxCell id="code_media" parent="1" vertex="1" style="shape=card;size=10;whiteSpace=wrap;html=1;fillColor=#E7F2E2;strokeColor=#5C8A3A;fontColor=#33491F;fontFamily=Courier New;fontSize=10;shadow=1;" value="2 code files">
          <mxGeometry x="425" y="126" width="145" height="30" as="geometry" />
        </mxCell>

        <!-- gold trace links (solid) -->
        <mxCell id="e_s23d" parent="1" edge="1" source="s23" target="db" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s24d" parent="1" edge="1" source="s24" target="db" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s27m" parent="1" edge="1" source="s27" target="media_access" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s28m" parent="1" edge="1" source="s28" target="media_access" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dc" parent="1" edge="1" source="db" target="code_db" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mc" parent="1" edge="1" source="media_access" target="code_media" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- tempting match absent from the hand-labeled gold standard (dashed red) -->
        <mxCell id="e_s27d" parent="1" edge="1" source="s27" target="db" value="rejected" style="edgeStyle=none;html=1;curved=1;strokeColor=#C0392B;strokeWidth=1.5;dashed=1;dashPattern=6 4;endArrow=classic;endFill=1;fontColor=#C0392B;fontSize=9;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- direct doc-code links (purple): one per chain, the composition of doc-model + model-code -->
        <mxCell id="e_s23c" parent="1" edge="1" source="s23" target="code_db" value="doc-code links" style="edgeStyle=none;html=1;curved=1;strokeColor=#6A4C93;strokeWidth=1.5;endArrow=classic;endFill=1;fontColor=#6A4C93;fontSize=9;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s28c" parent="1" edge="1" source="s28" target="code_media" value="doc-code links" style="edgeStyle=none;html=1;curved=1;strokeColor=#6A4C93;strokeWidth=1.5;endArrow=classic;endFill=1;fontColor=#6A4C93;fontSize=9;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend_forms" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#666666;" value="alias &#183; coreference &#183; evidence check">
          <mxGeometry x="180" y="176" width="260" height="16" as="geometry" />
        </mxCell>
        <mxCell id="legend_direct" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#6A4C93;" value="doc-code links (direct)">
          <mxGeometry x="220" y="212" width="180" height="16" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
