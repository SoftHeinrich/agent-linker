<mxfile host="Electron" agent="Claude">
  <diagram id="jabref-trace-example" name="JabRef trace example">
    <mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="575" pageHeight="192" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Mirror of figures/jabref_trace_example.py (matplotlib is the actual generator). -->

        <!-- column headers -->
        <mxCell id="h1" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#000000;" value="Documentation">
          <mxGeometry x="0" y="0" width="210" height="15" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#000000;" value="Architecture model">
          <mxGeometry x="250" y="0" width="120" height="15" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#000000;" value="Code">
          <mxGeometry x="420" y="0" width="150" height="15" as="geometry" />
        </mxCell>

        <!-- documentation sentences (numeric order: S6, S7 -> gui; S11 -> preferences) -->
        <mxCell id="s6" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S6 &quot;&#8230;the &lt;font color=&quot;#2F5BB7&quot;&gt;&lt;b&gt;UI&lt;/b&gt;&lt;/font&gt; renders the&#xa;main application window.&quot;">
          <mxGeometry x="0" y="20" width="210" height="32" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S7 &quot;&#8230;&lt;font color=&quot;#2F5BB7&quot;&gt;&lt;b&gt;it&lt;/b&gt;&lt;/font&gt; knows the user&#xa;and his &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;preferences&lt;/b&gt;&lt;/font&gt;.&quot;">
          <mxGeometry x="0" y="60" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s11" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#8C8C8C;fontColor=#333333;fontSize=11;arcSize=12;shadow=1;align=left;spacingLeft=6;spacingRight=6;" value="S11 &quot;The &lt;b&gt;preferences&lt;/b&gt; represents all&#xa;information customizable by a user.&quot;">
          <mxGeometry x="0" y="112" width="210" height="40" as="geometry" />
        </mxCell>

        <!-- architecture-model components -->
        <mxCell id="gui" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE3F2;strokeColor=#4664AA;fontColor=#1F2D52;fontFamily=Courier New;fontStyle=1;fontSize=12;arcSize=14;shadow=1;" value="gui">
          <mxGeometry x="255" y="43" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pref" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE3F2;strokeColor=#4664AA;fontColor=#1F2D52;fontFamily=Courier New;fontStyle=1;fontSize=12;arcSize=14;shadow=1;" value="preferences">
          <mxGeometry x="255" y="117" width="110" height="30" as="geometry" />
        </mxCell>

        <!-- code packages (one per component) -->
        <mxCell id="code_gui" parent="1" vertex="1" style="shape=card;size=10;whiteSpace=wrap;html=1;fillColor=#E7F2E2;strokeColor=#5C8A3A;fontColor=#33491F;fontFamily=Courier New;fontSize=11;shadow=1;" value="org/jabref/gui/">
          <mxGeometry x="420" y="43" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="code" parent="1" vertex="1" style="shape=card;size=10;whiteSpace=wrap;html=1;fillColor=#E7F2E2;strokeColor=#5C8A3A;fontColor=#33491F;fontFamily=Courier New;fontSize=11;shadow=1;" value="org/jabref/&#xa;preferences/">
          <mxGeometry x="420" y="112" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- gold trace links (solid) -->
        <mxCell id="e_s6g" parent="1" edge="1" source="s6" target="gui" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s7g" parent="1" edge="1" source="s7" target="gui" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s11p" parent="1" edge="1" source="s11" target="pref" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pc" parent="1" edge="1" source="pref" target="code" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gc" parent="1" edge="1" source="gui" target="code_gui" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- false positive (dashed red) -->
        <mxCell id="e_s7p" parent="1" edge="1" source="s7" target="pref" value="false positive" style="edgeStyle=none;html=1;curved=1;strokeColor=#C0392B;strokeWidth=1.5;dashed=1;dashPattern=6 4;endArrow=classic;endFill=1;fontColor=#C0392B;fontSize=9;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- direct doc-code links (purple): one per chain, the composition of doc-model + model-code -->
        <mxCell id="e_s6c" parent="1" edge="1" source="s6" target="code_gui" value="doc-code link (direct)" style="edgeStyle=none;html=1;curved=1;strokeColor=#6A4C93;strokeWidth=1.5;endArrow=classic;endFill=1;fontColor=#6A4C93;fontSize=9;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s11c" parent="1" edge="1" source="s11" target="code" value="doc-code link (direct)" style="edgeStyle=none;html=1;curved=1;strokeColor=#6A4C93;strokeWidth=1.5;endArrow=classic;endFill=1;fontColor=#6A4C93;fontSize=9;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
